# ============================================================
#  我的世界开发者收益 QQ 机器人 —— 环境变量示例
#  复制本文件为 .env 后按需修改
# ============================================================

# ---------- 1. NoneBot 基础配置 ----------
# 采用「反向 WebSocket」：由 NapCat 主动连到本机器人（本机监听 8080 端口）。
# NapCat 中请新建「WebSocket 客户端（反向）」，地址填：
#     ws://127.0.0.1:8080/onebot/v11/ws
HOST=127.0.0.1
PORT=8080
# 若 NapCat 里设置了 token，请保持一致
ONEBOT_ACCESS_TOKEN=
# 命令前缀（空字符串表示无需前缀，@机器人 或私聊直接说话即可）
COMMAND_START=["/", ""]
# 超级管理员 QQ（可选）
SUPERUSERS=[]

# 说明：默认驱动 ~fastapi 不支持「正向 WebSocket」。
# 若你更想用正向方式（机器人主动连 NapCat），需安装 aiohttp 驱动并开启：
#     python -m pip install "nonebot2[aiohttp]"
#     DRIVER=~aiohttp
#     ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ---------- 2. 我的世界开发者平台配置 ----------
# 登录开发者平台后从浏览器 DevTools 复制的完整 Cookie（必填，见 README）
MCDEV_COOKIE=

# 接口基址（来自开发者平台前端，一般无需修改）
MCDEV_BASE_URL=https://mc-launcher.webapp.163.com/

# 平台选择：pe=手机版组件  pc=电脑版组件  jpe=手机版联机  jpc=电脑版联机
MCDEV_PLATFORM=pe

# 只统计名称包含该关键词的作品（留空表示统计全部）。例如：地图
MCDEV_ITEM_KEYWORD=

# 请求超时（秒）与结果缓存（秒）
MCDEV_TIMEOUT=20
MCDEV_CACHE_TTL=300

# 是否强制使用演示数据（true 时忽略 Cookie，用于无凭证试跑）
MCDEV_MOCK=false

# ---------- 3. 图表推送 ----------
# 是否启用图表指令（返回图片）；关闭后自动降级为文字
MCDEV_CHART_ENABLED=true
# 排行图 / 看板中展示的作品数量上限
MCDEV_CHART_TOP_N=8
# 趋势图起始日期（如作品上线日，格式 YYYY-MM-DD）；留空则默认最近 90 天
MCDEV_TREND_START=

# ---------- 3.5 开发者身份与收益分成 ----------
# 是否在消息署名与图表中显示开发者昵称 + 头像 logo
MCDEV_SHOW_PROFILE=true
# 生态成本分摊比例（0~1）。填 0 表示自动按官方结算反推（推荐）
MCDEV_ECOSYSTEM_COST_RATE=0
# 鼓励金额比例（鼓励金额 = 开发者分成 × 该比例）。0 表示不计
MCDEV_INCENTIVE_RATE=0
# 团队贡献值分成：名字:占比:QQ号（多项逗号分隔，QQ 留空则只显示名字不 @）
#   例：十方:10:10001,炜炜爱搞事:30:10002,hisuperwan:60:10003
MCDEV_PARTNERS=十方:10:,炜炜爱搞事:30:,hisuperwan:60:
# 汇总「预计实际收益」时回溯的月份数
MCDEV_SPLIT_MONTHS=12
# 定时推送时是否附带团队分成（含 @）
MCDEV_PUSH_SPLIT=true
# 启动时扫描指定群成员，便于查找团队成员 QQ 号（留空则不扫描）
# 也可在群里直接发送「成员」指令查看
MCDEV_MEMBER_SCAN=

# 允许使用机器人的 QQ 号，多个用逗号分隔；留空表示所有人可用
MCDEV_ALLOWED_USERS=

# ---------- 4. 定时推送（可选，支持每天多个时间点） ----------
MCDEV_PUSH_ENABLED=false
# 推送目标：群号或 QQ 号，多个用逗号分隔
MCDEV_PUSH_TARGETS=
# 推送时是否附带收益看板图片
MCDEV_PUSH_CHART=true
# 每天推送的小时（24 小时制，逗号分隔）。例如每 2 小时一次：
#   MCDEV_PUSH_HOURS=10,12,14,16,18,20,22,0
# 兼容旧写法：只填一个小时时可用 MCDEV_PUSH_HOUR=9
MCDEV_PUSH_HOURS=10,12,14,16,18,20,22,0
# 推送的分钟（0-59），对所有小时生效
MCDEV_PUSH_MINUTE=0

# ---------- 5. 保活守护（仅 Android / Termux 使用） ----------
# 由 deploy/android/watchdog.sh 读取，用于息屏后自动保活、崩溃自动重启
# 进程检查间隔（秒）
MCDEV_WATCHDOG_INTERVAL=30
# 填了机器人的 QQ 号，守护会额外看护 NapCat（不在就自动拉起）；留空则不看护
MCDEV_WATCHDOG_QQ=

# ---------- 6. 新活动监控（模组征集） ----------
# 发现新的模组征集活动时，自动推送到群（首次运行只建立基线，不推送历史活动）
MCDEV_ACTIVITY_WATCH=true
# 每天检查的小时（逗号分隔）
MCDEV_ACTIVITY_HOURS=9,15,21
# 检查的分钟
MCDEV_ACTIVITY_MINUTE=5
# 活动推送目标（群号或 QQ 号，逗号分隔）；留空则复用 MCDEV_PUSH_TARGETS
MCDEV_ACTIVITY_TARGETS=
